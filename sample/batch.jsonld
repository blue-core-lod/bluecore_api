      "summary": {
        "@type": "Summary",
        "rdfs:label": "Senior music specialist Mark Horowitz discusses his one-year project examining, selecting, transcribing and editing the correspondence in the Library's Oscar Hammerstein II Collection. The project, under the auspices of the John W. Kluge Center at the Library of Congress, revealed insights into the life and work of this extraordinary American lyricist, librettist, theatrical producer, director and humanitarian. The collection, recently processed by archivist Nancy Seeger, allowed Horowitz to read through over 20,000 letters and ultimately to transcribe more than 4,600 of them, with plans for them to form a Library website"
      },
      "title": {
        "@type": "Title",
        "mainTitle": "Behind the Scenes with the Oscar Hammerstein Correspondence"
      },
      "http://purl.org/dc/terms/isPartOf": {
        "@id": "http://id.loc.gov/resources/works"
      }
    },
