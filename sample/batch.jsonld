      "editionStatement": [
        "[Ming ke ben]",
        {
          "@language": "zh-hani",
          "@value": "[明刻本]"
        }
      ],
      "extent": {
        "@type": "Extent",
        "rdfs:label": "2 volumes"
      },
      "hasItem": {
        "@id": "http://id.loc.gov/resources/items/18623045"
      },
      "identifiedBy": {
        "@type": "Lccn",
        "rdf:value": "  2014514147"
      },
      "instanceOf": "http://id.loc.gov/resources/works/18623045",
      "issuance": {
        "@id": "http://id.loc.gov/vocabulary/issuance/mono"
      },
      "media": [
        {
          "@id": "http://id.loc.gov/vocabulary/mediaTypes/c"
        },
        {
          "@id": "http://id.loc.gov/vocabulary/mediaTypes/n"
        }
      ],
      "note": [
        {
          "@type": "Note",
          "rdfs:label": "In case."
        },
        {
          "@type": [
            "Note",
            "http://id.loc.gov/vocabulary/mnotetype/addphys"
          ],
          "rdfs:label": "Also available in digital form."
        },
        {
          "@type": "Note",
          "rdfs:label": {
            "@language": "zh-hani",
            "@value": "LC copy lacks: 新官軌範 : 一卷. 5 DLC"
          }
        },
        {
          "@type": "Note",
          "rdfs:label": {
            "@language": "zh-hani",
            "@value": "不著撰人姓氏. Anonymous."
          }
        },
        {
          "@type": "Note",
          "rdfs:label": {
            "@language": "zh-hani",
            "@value": "不著撰人姓氏。卷內書題作「重刻聖朝欽定各項新官到任儀註」，有華州郭半山序，稱原為關中劉子珍藏本，以友人趙廷錫勸，公之於世，遂授諸梓」。凡儀註一卷記鄉飮酒，釋奠節社等儀節；軌範一卷，則指示為政與牧民之法。牧民又分九目：曰上任，曰直日，曰御史，曰民情，曰公務，曰糧料，曰禮儀，曰禦??，曰詞訟。按此類短書，頗有實用，故傳本甚多，而各本不盡相同，蓋隨時有增損故也。攷皇明太學志卷二經籍門堪印書版數目下，有「新官到任須知大小板二十八塊，舊志五十四塊」；千頃堂書目卷九儀注類，有到任儀註欽定儀註輯錄各一冊，均當與是書相近。又四庫存目卷八十，著錄明文武諸司衙門官制五卷，提要云：「居官列儀註便覽新官軌範」，館藏本適闕此二書，然其內容必相近。卷內有：「弢齋藏書記」長方印，弢齋徐世昌號也，故襯紙用水竹??人詩集則此為徐式舊藏本矣。郭半山(序)嘉靖四十四年(一五六五)."
          }
        },
        {
          "@type": "Note",
          "rdfs:label": {
            "@language": "zh-hani",
            "@value": "十二行二十二字. Twelve lines, with twenty-two characters per line."
          }
        },
        {
          "@type": "Note",
          "rdfs:label": {
            "@language": "zh-hani",
            "@value": "頁405-406. 提要380字. 詳述此類短書之特色."
          }
        }
      ],
