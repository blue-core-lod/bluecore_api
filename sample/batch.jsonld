      "summary": {
        "@type": "Summary",
        "rdfs:label": "\"Developing readers learn about the dads of the animal world in this low-level search-and-find beginning reader. Reinforces new vocabulary with close-up images of baby animals and their dads. A great early STEM book to inspire learning about animals and life science for kindergartners and first graders\"-- Provided by publisher."
      },
      "title": {
        "@type": "Title",
        "mainTitle": "Animal dads"
      },
