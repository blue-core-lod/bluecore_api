      "summary": {
        "@type": "Summary",
        "rdfs:label": "\"Accessible to a broad audience interested in land justice for Indigenous Peoples, this multidisciplinary book synthesises and presents the challenges and opportunities for advancing land rights, making it useful to academics, practitioners and policy makers. This title is also available as open access on Cambridge Core\"-- Provided by publisher."
      },
      "supplementaryContent": [
        {
          "@id": "http://id.loc.gov/vocabulary/msupplcont/bibliography"
        },
        {
          "@id": "http://id.loc.gov/vocabulary/msupplcont/index"
        }
      ],
      "tableOfContents": {
        "@type": "TableOfContents",
        "rdfs:label": "Latin America : The Elusive Promise of Indigenous Land Rights in Paraguay-Achievements, Challenges and Current Trends -- Recognizing and Reclaiming Indigenous Peoples' Constitutional Land Rights in Brazil-Challenges and Opportunities -- Indigenous Peoples and Territorial Rights in Colombia-Advances and Challenges in the \"Implementation Gap\" -- Indigenous Land Rights in Chile-Dispossession, Misrecognition and Litigation -- Australia, Canada & New Zealand : Aboriginal Land Rights in Australia-Neither National nor Uniform -- Dispossession by Treaty, Dispossession by Statute-Indigenous Title in Eastern and Western Canada -- Māori Land Law in Aotearoa New Zealand-Recognizing Land as tāonga tuku iho -- Africa & Asia : Land Rights of Indigenous Peoples in the Democratic Republic of Congo-\"First Come, Last Served\" -- San Land Rights in Botswana-A Critical Analysis -- Rights to Land among Amazigh Peoples in Morocco-The Case of the High Atlas -- Adivasis and Land Rights in India-Dispossession and the \"Implementation Gap\" -- Legal Privileges and the Effective Recognition of Indigenous Land Rights-Lessons from Malaysia -- Indigenous Peoples and Electoral Politics in Thailand and Cambodia-One Strategy to Secure Land Rights in Contested Spaces -- Conclusion-Reclaiming Land Rights under the Pressure of Nation States -- Insights and Future Directions from Sápmi."
      },
      "title": {
        "@type": "Title",
        "mainTitle": "Land rights now"
      },
      "http://purl.org/dc/terms/isPartOf": {
        "@id": "http://id.loc.gov/resources/works"
      }
    },
