      "summary": {
        "@type": "Summary",
        "rdfs:label": "Read by Jaime Manrique reads a fragment of a poem with an unknown title. Read by Jimmy McCourt: Regal Park; About Sartre (?); Read by Honor Moore: Powerless, by Tim Dlugos. Tim Dlugos, Je Suis ein Americano, 1979. Susie Timmons and Mary Ellen ODonnell share memories. Read by David Trinidad: G-9, by Dlugos."
      },
      "title": {
        "@type": "Title",
