      "tableOfContents": {
        "@type": "TableOfContents",
        "rdfs:label": "Snart kommer natten -- Här står en man -- Kommer du ihåg mig? -- Stan är inte stor nog (för oss två) -- Bara din -- Utan dig -- Jag kommer ängra mig -- Om jag bara visste var hom fanns -- Vi hade allt -- Nära varann -- Jag vill vara med dig."
      },
